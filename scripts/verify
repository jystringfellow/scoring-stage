#!/bin/sh
cd "$(dirname "$0")/.." || exit 1
log=$(mktemp "${TMPDIR:-/tmp}/verify.XXXXXX") || exit 1

run() {
 sh -c "$2" >"$log" 2>&1
 status=$?
 if [ "$status" -ne 0 ]; then
  echo "verify failed at step: $1 (exit $status)"
  echo "--- last 40 lines of $1 ---"
  tail -n 40 "$log" | cut -c1-300
  echo "full log: $log"
  exit "$status"
 fi
}

run 'dependencies' 'go mod download && go mod verify'
run 'gofmt' 'unformatted=$(gofmt -l .) && { [ -z "$unformatted" ] || { printf "%s\n" "$unformatted"; exit 1; }; }'
run 'vet' 'go vet -mod=readonly ./...'
run 'unit tests' 'go test -mod=readonly -count=1 ./...'

rm -f "$log"
